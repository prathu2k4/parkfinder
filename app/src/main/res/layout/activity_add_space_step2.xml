<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        app:elevation="0dp">
        <androidx.appcompat.widget.Toolbar
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Add Parking Space"
            app:titleTextColor="@color/dark_grey"
            app:navigationIcon="@android:drawable/ic_menu_revert" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp"
            android:paddingBottom="16dp"
            android:gravity="center">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✓ Basic Info" android:textColor="@color/green_main" android:textStyle="bold" />
            <View android:layout_width="40dp" android:layout_height="2dp" android:background="@color/green_main" android:layout_marginHorizontal="8dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="❷ Details" android:textStyle="bold" android:textColor="@color/dark_grey" />
            <View android:layout_width="40dp" android:layout_height="2dp" android:background="#E0E0E0" android:layout_marginHorizontal="8dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="③ Photos" android:textColor="@color/light_grey" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/appBarLayout"
        android:layout_above="@id/bottomBar"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Parking Details"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/dark_grey"
                android:layout_marginBottom="16dp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Parking Name *">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etParkingName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Total Slots *">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTotalSlots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vehicle Types Allowed *"
                android:textColor="@color/dark_grey"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTypeCar"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Car"
                    app:backgroundTint="#2D3748"
                    android:textColor="@android:color/white"
                    android:layout_marginEnd="8dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTypeBike"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bike"
                    android:textColor="@color/dark_grey"
                    app:strokeColor="@color/light_grey" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Operating Hours *">
                <AutoCompleteTextView
                    android:id="@+id/spinnerOperatingHours"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:text="24/7" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Price per Hour (₹) *">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPricePerHour"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:padding="24dp"
        android:background="@android:color/white">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinueToStep3"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Continue"
            app:backgroundTint="#2D3748" />
    </LinearLayout>
</RelativeLayout>