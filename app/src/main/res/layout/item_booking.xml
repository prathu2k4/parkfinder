<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView android:id="@+id/tvBookingName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mall Parking" android:textStyle="bold" android:textSize="16sp" android:textColor="@color/dark_grey"/>
        <TextView android:id="@+id/tvBookingStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Completed" android:textColor="@color/light_grey" android:layout_alignParentEnd="true" android:textSize="12sp"/>

        <TextView android:id="@+id/tvBookingAddress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="123 Main St, Downtown" android:textColor="@color/light_grey" android:layout_below="@id/tvBookingName" android:layout_marginTop="4dp"/>
        <TextView android:id="@+id/tvBookingDateTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12 Oct, 10:00 AM - 12:00 PM" android:textColor="@color/dark_grey" android:layout_below="@id/tvBookingAddress" android:layout_marginTop="8dp"/>
        <TextView android:id="@+id/tvBookingPrice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹100" android:textStyle="bold" android:textColor="@color/dark_grey" android:layout_below="@id/tvBookingDateTime" android:layout_marginTop="8dp"/>

        <TextView android:id="@+id/tvBookingAction" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☆ Rate &amp; Review" android:textColor="@color/teal_main" android:textStyle="bold" android:layout_alignParentEnd="true" android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</androidx.cardview.widget.CardView>