<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bottom_sheet_bg"> <RelativeLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="24dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Filters"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/dark_grey" />
    <ImageButton
        android:id="@+id/btnCloseFilter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_close_clear_cancel" />
</RelativeLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Distance"
        android:textColor="@color/dark_grey" />
    <com.google.android.material.slider.Slider
        android:id="@+id/sliderDistance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0.0"
        android:valueTo="20.0"
        android:value="15.0"
        app:thumbColor="@color/teal_main"
        app:trackColorActive="@color/teal_main" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Price Range"
        android:textColor="@color/dark_grey"
        android:layout_marginTop="16dp" />
    <com.google.android.material.slider.RangeSlider
        android:id="@+id/rangeSliderPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0.0"
        android:valueTo="500.0"
        app:values="@array/initial_price_range"
        app:thumbColor="@color/teal_main"
        app:trackColorActive="@color/teal_main" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Vehicle Compatibility"
        android:textColor="@color/dark_grey"
        android:layout_marginTop="16dp" />
    <CheckBox
        android:id="@+id/cbCar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Car" />
    <CheckBox
        android:id="@+id/cbBike"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bike" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="32dp">
        <Button
            android:id="@+id/btnResetFilters"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Reset"
            android:textColor="@color/teal_main" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplyFilters"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Apply Filters"
            app:backgroundTint="@color/teal_main" />
    </LinearLayout>

</LinearLayout>