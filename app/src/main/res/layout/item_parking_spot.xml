<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView android:id="@+id/tvSpotName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="City Center Parking" android:textStyle="bold" android:textSize="16sp" android:textColor="@color/dark_grey"/>
            <TextView android:id="@+id/tvSpotDistance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📍 0.8 km" android:textColor="@color/light_grey" android:layout_marginTop="4dp"/>
            <TextView android:id="@+id/tvSpotTimings" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🕒 7 AM - 10 PM" android:textColor="@color/light_grey" android:layout_marginTop="2dp"/>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CAR" android:textSize="10sp" android:textColor="#3B82F6" android:background="@drawable/rounded_bg_light" android:paddingHorizontal="6dp" android:paddingVertical="2dp" android:layout_marginEnd="4dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BIKE" android:textSize="10sp" android:textColor="#3B82F6" android:background="@drawable/rounded_bg_light" android:paddingHorizontal="6dp" android:paddingVertical="2dp"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">
            <TextView android:id="@+id/tvSpotPrice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹75" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/teal_main"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="/ hour" android:textSize="12sp" android:textColor="@color/light_grey"/>
            <TextView android:id="@+id/tvSpotAvailability" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🚗 15 / 50" android:textColor="@color/dark_grey" android:textStyle="bold" android:layout_marginTop="16dp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>